# Copy to .env and fill in. All values are embedded in the public bundle at build time.
# In CI these come from GitHub repository secrets with the same names.

# EmailJS (https://dashboard.emailjs.com)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Optional: auto-reply sent to the visitor after they submit the form
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable GA.
VITE_GOOGLE_ANALYTICS_ID=
